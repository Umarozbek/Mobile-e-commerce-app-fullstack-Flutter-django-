<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: Asosiy API HTTPS (million-halal-mart-3.onrender.com).
  Refresh token URL hozircha HTTP (209.38.109.22) bo'lgani uchun
  faqat shu host uchun cleartext ruxsat etiladi.
